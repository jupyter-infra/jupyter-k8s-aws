schema_version: 2
required:
  domain: "${JD_E2E_VAR_DOMAIN}"
  subdomain: "${JD_E2E_VAR_SUBDOMAIN}"
  letsencrypt_email: "${JD_E2E_VAR_EMAIL}"
  oauth_app_client_id: "${JD_E2E_VAR_OAUTH_APP_CLIENT_ID}"
  oauth_allowed_teams: ${JD_E2E_VAR_OAUTH_ALLOWED_TEAMS}
required_sensitive:
  oauth_app_client_secret: "${JD_E2E_VAR_OAUTH_APP_CLIENT_SECRET}"
overrides:
  admin_role_names: ${JD_E2E_VAR_ADMIN_ROLE_NAMES}
  cluster_log_retention_days: 7
  # Chart versions are intentionally NOT overridden here: CI must test whatever
  # the eks-oidc template preset pins. Hardcoding them caused a stale operator
  # (0.1.2) to be deployed after the preset moved to 0.2.0, silently breaking
  # workspace tests via the old operator's default-template webhook.
  workspaces_idle_shutdown_timeout_min: 1
